# Copy to .env for local development. In production these live in Vercel's settings.
DATABASE_URL=postgresql://localhost/radar_vie
# Argon2 hash of the sign-in password (python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('...'))")
APP_PASSWORD_HASH=
# Random, at least 32 characters (python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# Random, at least 32 characters; the scheduled agents send it as a bearer token
API_TOKEN=
# false only for local http
SECURE_COOKIES=false
